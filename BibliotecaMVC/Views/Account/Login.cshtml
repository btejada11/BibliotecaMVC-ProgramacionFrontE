@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
           
            <div class="card shadow-lg border-0 rounded-3 bg-dark text-white">
                <div class="card-header border-bottom border-secondary text-center py-4">
                    <h3 class="fw-bold mb-1">BibliotecaMVC</h3>
                    <p class="text-muted small mb-0">Introduce tus credenciales para ingresar al sistema</p>
                </div>

                <div class="card-body p-4">
                   
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 small" role="alert">
                            <div asp-validation-summary="ModelOnly"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />

                      
                        <div class="mb-3">
                            <label asp-for="UserNameOrEmail" class="form-label small fw-semibold text-muted text-uppercase tracking-wider"></label>
                            <input asp-for="UserNameOrEmail" class="form-control bg-secondary text-white border-0 py-2" placeholder="Usuario o correo electrónico" autocomplete="username" />
                            <span asp-validation-for="UserNameOrEmail" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold text-muted text-uppercase tracking-wider"></label>
                            <input asp-for="Password" type="password" class="form-control bg-secondary text-white border-0 py-2" placeholder="••••••••" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                     
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input bg-secondary border-0" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>

                       
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                Iniciar sesión
                            </button>
                        </div>
                    </form>
                </div>

               
                <div class="card-footer border-top border-secondary text-center py-3 bg-transparent">
                    <p class="mb-0 small text-muted">¿No tienes una cuenta? <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Regístrate aquí</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
