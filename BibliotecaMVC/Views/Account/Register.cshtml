@model RegisterViewModel

@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
       
            <div class="card shadow-lg border-0 rounded-3 bg-dark text-white">
                <div class="card-header border-bottom border-secondary text-center py-4">
                    <h3 class="fw-bold mb-1">Crear Cuenta</h3>
                    <p class="text-muted small mb-0">Regístrate para obtener acceso a BibliotecaMVC</p>
                </div>

                <div class="card-body p-4">
               
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 small" role="alert">
                            <div asp-validation-summary="ModelOnly"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Register" method="post">

                  
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label small fw-semibold text-muted text-uppercase tracking-wider"></label>
                            <input asp-for="Username" class="form-control bg-secondary text-white border-0 py-2" placeholder="Ej: ltejada" />
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                        </div>

                    
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted text-uppercase tracking-wider"></label>
                            <input asp-for="Email" type="email" class="form-control bg-secondary text-white border-0 py-2" placeholder="usuario@correo.com" />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                     
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold text-muted text-uppercase tracking-wider"></label>
                            <input asp-for="Password" type="password" class="form-control bg-secondary text-white border-0 py-2" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                     
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted text-uppercase tracking-wider"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control bg-secondary text-white border-0 py-2" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                    
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                                Registrarse
                            </button>
                        </div>
                    </form>
                </div>

               
                <div class="card-footer border-top border-secondary text-center py-3 bg-transparent">
                    <p class="mb-0 small text-muted">¿Ya tienes una cuenta? <a asp-action="Login" class="text-success fw-bold text-decoration-none">Inicia sesión aquí</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
