@model IEnumerable<BibliotecaMVC.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista de Categorías</h2>
</div>
<a class="btn btn-primary" asp-controller="Categorias" asp-action="Create">Agregar Categoria</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.ID</td>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        var mensaje = '@(TempData["SuccessMessage"] ?? "")';
        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                timer: 5000,
                showConfirmButton: false
            });
        }
    </script>
}