@model List<BibliotecaMVC.Models.Libro>
<h2>Catálogo de libros</h2>
<table class="table table-striped">
    <thead> 
        <tr>
            <th>ID</th>
            <th>Titulo</th>
            <th>Autor</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody> 
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.ID</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Categoria</td>
                <td>$@libro.Precio</td>
                <td>
                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Prestado</span>
                    }
                </td>
            </tr>
        }

    </tbody>
</table>

