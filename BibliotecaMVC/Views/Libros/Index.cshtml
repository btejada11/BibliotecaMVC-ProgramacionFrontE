@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Gestión de Libros";
}

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="bi bi-journal-bookmark-fill"></i> @ViewData["Title"]</h4>
        <a class="btn btn-success btn-sm fw-bold" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Nuevo Libro
        </a>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3"><i class="bi bi-info-circle"></i> Hay <strong>@Model.Count()</strong> libros registrados en el inventario.</p>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle border">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td><strong>@libro.Titulo</strong></td>
                            <td>@libro.Autor</td>
                            <td><span class="badge bg-secondary text-light border">@libro.Categoria</span></td>
                            <td>$@libro.Precio.ToString("F2")</td>
                            <td>
                                @if (libro.Disponible)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Prestado</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-sm btn-info text-white" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-sm btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>