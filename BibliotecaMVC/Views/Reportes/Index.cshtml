@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Reportes de Libros";
    var autores = ViewBag.Autores as List<string> ?? new List<string>();
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var autorSel = ViewBag.AutorSeleccionado as string;
    var categoriaSel = ViewBag.CategoriaSeleccionada as string;
}

<h1>Reportes de Libros</h1>

<form method="get" asp-controller="Reportes" asp-action="Index" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label for="autor" class="form-label">Autor</label>
        <select id="autor" name="autor" class="form-select">
            <option value="">Todos</option>
            @foreach (var a in autores)
            {
                <option value="@a" selected="@(a == autorSel)">@a</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label for="categoria" class="form-label">Categoría</label>
        <select id="categoria" name="categoria" class="form-select">
            <option value="">Todas</option>
            @foreach (var c in categorias)
            {
                <option value="@c" selected="@(c == categoriaSel)">@c</option>
            }
        </select>
    </div>

    <div class="col-md-4 d-flex gap-2 flex-wrap">
        <button type="submit" class="btn btn-secondary">Filtrar</button>

        <button type="submit" formaction="@Url.Action("DescargarPdf", "Reportes")" class="btn btn-danger">
            Generar reporte PDF
        </button>

        <button type="submit" formaction="@Url.Action("DescargarExcel", "Reportes")" class="btn btn-success">
            Exportar a Excel
        </button>
    </div>
</form>

<p class="fw-bold">Total de libros: @Model.Count()</p>

<table class="table table-striped table-bordered">
    <thead class="table-primary">
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th class="text-end">Precio</th>
            <th class="text-center">Disponible</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.ID</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Categoria</td>
                <td class="text-end">@($"${libro.Precio:N2}")</td>
                <td class="text-center">@(libro.Disponible ? "Sí" : "No")</td>
            </tr>
        }
    </tbody>
</table>